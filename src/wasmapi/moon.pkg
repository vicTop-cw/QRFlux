// WASM/JS export surface for QRFlux.
// A foreign_library package re-exporting the web bindings under stable
// symbol names, so a JavaScript host can call them directly.
//
// Build: moon build --target js --release
//        moon build --target wasm-gc --release
//
// STATUS (2026-11-15): exports verified present in both artifacts and
// the js artifact is wired into web/camera.html as the primary in-browser
// decoder (see src/wasmapi/api.mbt header for the hex-formatting bug
// that previously blocked this, fixed via moon#2527).
import {
  "vicTop-cw/QRFlux/src/web",
}

pkgtype(kind: "foreign_library")

options(
  link: {
    "wasm-gc": { "use-js-builtin-string": true },
    "js": {
      "exports": [
        "qrflux_encode_qr",
        "qrflux_decode_image_png",
        "qrflux_decode_qr",
      ],
      "format": "esm",
    },
  },
)
