name = "vicTop-cw/QRFlux"

version = "0.2.0"

readme = "README.mbt.md"

repository = "https://github.com/vicTop-cw/QRFlux"

license = "Apache-2.0"

keywords = [ "qr", "barcode", "file-transfer", "fountain-code", "lossless" ]

preferred_target = "native"

description = "QRFlux: pure MoonBit QR lossless file transfer - compress, split, dynamic QR stream, lossless verify"
